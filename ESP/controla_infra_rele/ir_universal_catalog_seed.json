  "identification_engine": {
    "goals": [
      "Identificar perfil funcional do aparelho por tentativa controlada.",
      "Permitir teste automático, semiautomático e manual.",
      "Salvar o perfil correto escolhido pelo usuário.",
      "Permitir fallback para clonagem por receptor IR."
    ],
    "modes": {
      "manual_step": "Usuário clica em 'Testar próximo'; sistema envia um candidato por vez.",
      "auto_scan": "Sistema envia candidatos em sequência com delay configurável e usuário clica em 'Funcionou/Parar'.",
      "reverse_delay_review": "Quando o usuário para o scan, a UI mostra os últimos N sinais enviados antes do stop para escolher o mais provável.",
      "learn_mode": "Se nenhum candidato funcionar, sistema entra em modo captura pelo receptor IR e salva RAW/decodificado."
    },
    "scan_config_defaults": {
      "delay_between_tests_ms": 1500,
      "min_delay_ms": 300,
      "max_delay_ms": 5000,
      "rollback_window": 5,
      "preferred_test_commands": [
        "mute",
        "volume_up",
        "input"
      ],
      "avoid_power_toggle_first": true,
      "notes": "Meio milissegundo é rápido demais para TV/IR e para observação humana. Use 300 ms a 1500 ms. Para Power, use 2s a 5s."
    },
    "candidate_ranking": [
      "Filtrar por device_type.",
      "Filtrar por brand quando informado.",
      "Priorizar comandos com validation_status tested_working/user_captured.",
      "Priorizar confidence high, depois medium, depois low.",
      "Priorizar comandos seguros: mute, volume_up, input, menu.",
      "Evitar power_toggle no primeiro teste.",
      "Agrupar por protocolo/modelo para não repetir sinais iguais.",
      "Se falhar, tentar protocolos prováveis da marca.",
      "Se falhar, oferecer modo de clonagem."
    ],
    "workflow": [
      {
        "step": 1,
        "name": "Selecionar aparelho",
        "ui": "Usuário escolhe tipo: TV, Ar-condicionado, Projetor, Soundbar, etc."
      },
      {
        "step": 2,
        "name": "Selecionar marca",
        "ui": "Usuário escolhe marca ou pula para modo amplo."
      },
      {
        "step": 3,
        "name": "Gerar fila de candidatos",
        "system": "Backend cria test_queue com base em device_type, brand, protocolos prováveis e comandos seguros."
      },
      {
        "step": 4,
        "name": "Testar sinais",
        "system": "ESP32 envia um comando por vez; UI mostra índice, protocolo, modelo candidato e botão Funcionou/Não/Parar."
      },
      {
        "step": 5,
        "name": "Confirmação secundária",
        "system": "Ao funcionar, testar outro comando do mesmo perfil, por exemplo volume/mute/menu."
      },
      {
        "step": 6,
        "name": "Salvar perfil",
        "system": "Salvar selected_profile com brand, model_candidate, protocol, command_map e validation_status."
      },
      {
        "step": 7,
        "name": "Caching no ESP32",
        "system": "Enviar perfil mínimo para memória local/NVS/LittleFS para comandos rápidos."
      },
      {
        "step": 8,
        "name": "Fallback",
        "system": "Se falhar, usar receiver IR para clonar controle original e cadastrar externamente."
      }
    ]
  },
